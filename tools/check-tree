#!/bin/sh
# Build a source tree out of tree, optionally with sanitizers or distcheck.

set -eu

usage()
{
	printf '%s\n' "usage: tools/check-tree [--sanitizers] [--distcheck] SOURCE" >&2
}

sanitizers=no
distcheck=no
while [ "$#" -gt 0 ]; do
	case "$1" in
	--sanitizers)
		sanitizers=yes
		;;
	--distcheck)
		distcheck=yes
		;;
	--help)
		usage
		exit 0
		;;
	-*)
		usage
		exit 2
		;;
	*)
		break
		;;
	esac
	shift
done
if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
	usage
	exit 2
fi
case "$1" in
/*)
	source=$1
	;;
*)
	source=$(cd "$1" && pwd)
	;;
esac
temporary=$(mktemp -d "${TMPDIR:-/tmp}/oaioauthc-check.XXXXXX")
build="$temporary/build"
input="$temporary/source"

cleanup()
{
	rm -rf "$temporary"
}

trap cleanup EXIT HUP INT TERM
mkdir "$input"
mkdir "$build"
if git -C "$source" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	git -C "$source" archive HEAD | tar -x -C "$input"
else
	(
		cd "$source"
		tar -c -f - .
	) | (
		cd "$input"
		tar -x -f -
	)
fi
source=$input
(
	cd "$source"
	autoreconf -fi
)
(
	cd "$build"
	if [ "$sanitizers" = yes ]; then
		"$source/configure" --enable-sanitizers
	else
		"$source/configure"
	fi
	make
	make check
	if [ "$distcheck" = yes ]; then
		make distcheck
	fi
)
